src/userland/robots/init_field.c
src/userland/robots/make_level.c
src/userland/robots/rob_move.c
src/userland/robots/move_robs.c
src/userland/robots/play_level.c
src/userland/robots/query.c
src/userland/robots/rnd_pos.c
src/userland/robots/score.c
# curses: the ONE aggregated toolchain TU (needs -DNOSCCS; termcap via
# libs="termlib" — curses does not fit the shared LIBC seg next to libc)
