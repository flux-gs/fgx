# Per-fixture libc archive select output.  run.sh's cleanup() and
# run_runtime.py's _LINK_INTERMEDIATES both remove these, so a completed run
# leaves none -- but an INTERRUPTED run leaves three per M-dir, and untracked
# noise in `git status` is exactly what makes a dirty tree look clean.
toolchain/tests/M*/libc.sel.c
toolchain/tests/M*/libc.sel.s
toolchain/tests/M*/libc.sel.data.s

# FGX2 C-tool build dirs: fully generated by the ninja graph (fcc output, the
