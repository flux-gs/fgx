# Statics that stay in libc's per-process CORE rather than a member block
# (shared libc SP2 spec, section 4): the printf engine's state, which
# putc-per-character output touches per byte (doprnt.c).  stdio's own
# state is _iob, a global, which the core holds anyway.  One unmangled name
# per line.
__lc_pf_mode
__lc_pf_iop
__lc_pf_stage
__lc_pf_sn
__lc_pf_out
__lc_pf_lim
__lc_pf_n
__lc_pf_gbuf
__lc_pf_glen
# findiop.c's sbuf: _smallbuf's initialiser takes its address, which a
# member block cannot give (the block is per-process and placed at load).
sbuf
