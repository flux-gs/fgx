# /root/.profile - the login shell's per-user profile.
#
# Stored on disk as DOT.PROFILE: ProDOS names must start with a letter, so
# the prodos FST maps a leading '.' to a "DOT." prefix (and back again in
# readdir).  Refer to it as /root/.profile from inside FGX; only the host
# side of disk_src/ sees the mapped name.
#
# This is the BSD hook: init seeds the system-wide login environment the way
# login(1) does, and the per-user profile extends it here.  init also chdir()s
# to /root before spawning the shell, because the Bourne shell opens
# ".profile" relative to the CURRENT directory rather than $HOME.
#
# Syntax is strict Bourne (assignment, then a bare `export NAME`); the
# combined `export NAME=value` form is a ksh-ism this shell rejects.

# Extend the inherited path rather than replacing it.  init IS the one place the
# BSD default lives -- /etc/profile was deleted 2026-08-15, having seeded nothing
# since jsh was removed.  Only /testbin is added here: it holds the MAME
# harness test binaries and exists on the dev image only, which is exactly what
# a per-user profile is for.  /usr/fgx/bin moved into init's own seed, where a
# system tool directory belongs -- here it reached root and no one else.
PATH=$PATH:/testbin
export PATH

# Prompt.  The Bourne shell defaults PS1 to "# " for root (main.c dfault of
# ps1nod), which is BSD-correct but indistinguishable from a comment marker
# or any stray '#' on screen -- the MAME acceptance tests use the prompt as
# their "the shell came back and is reading again" marker, and a bare "# "
# cannot serve as one.  A distinctive string can.
#
# This is the right place for it: PS1 is a user preference, and login(1) does
# not set it -- the shell defaults it and the profile overrides it.  init
# therefore keeps seeding only what login(1) really provides (PATH/HOME/TERM).
# setupenv() imports the environment before main.c's dfault() runs, so an
# exported PS1 wins over the built-in default.
PS1='fgx# '
export PS1
