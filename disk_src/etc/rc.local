# /etc/rc.local - site-specific startup, run last by /etc/rc.
# Remove the `#' to turn a line on; see docs/CONFIGURING.md.
#
# Time zone: the IIgs clock keeps local time, and the image ships UTC.
#	cp /usr/share/zoneinfo/America/Los_Angeles /etc/localtime

# serial ports, /dev/tty00 and /dev/tty01
#/sbin/modload serial >/dev/console 2>&1
# packet capture, /dev/bpf0
#/sbin/modload bpf >/dev/console 2>&1
# Second Sight console, ttyv3
#/sbin/modload sscon >/dev/console 2>&1
# desk accessories, /dev/cda
#/sbin/modload cda >/dev/console 2>&1

if [ "$INET" = YES ]
then
	# telnet logins
	#/sbin/inetd
	# network time
	#/sbin/ntpd
	:
fi
