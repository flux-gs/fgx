# A program rewritten in the same second it last ran still runs as its new
# self.  Rounds of echo-then-pwd through one path, the only change between
# a load and the rewrite after it being one run; a round whose pwd run
# printed anything but the directory ran a stale text.
mkdir /tmp/tgdir
cd /tmp/tgdir
cp /bin/echo /tmp/tg
chmod 755 /tmp/tg
for i in 1 2 3 4 5 6; do
cp /bin/echo /tmp/tg
/tmp/tg
cp /bin/pwd /tmp/tg
X=`/tmp/tg`
test "$X" = /tmp/tgdir || echo TG STALE $i
done
A=TG; echo $A DONE
