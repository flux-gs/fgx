# termlib renamed aside: a program needing it is refused, ldd lists it.
mv /lib/libtermlib.so.1.0 /lib/hold
/testbin/curssodyn
echo FIT nf=$?
ldd /testbin/curssodyn
mv /lib/hold /lib/libtermlib.so.1.0
# 100 bytes of arena held, then fitunder (150 under its link-time limit)
# is the first program to need termlib: its binder loads termlib with no
# room past its own scratch, 100 bytes lower than linked, and it runs.
# Then fitover (50 under) is refused.
/testbin/ldctl pad 100
/testbin/fitunder
echo FIT under=$?
LD_TRACE_LOADED_OBJECTS=1 /testbin/fitunder > /tmp/f1
echo FIT tres=`grep -c "ltermlib.1 => .*resident)" /tmp/f1`
/testbin/fitover
echo FIT over=$?
